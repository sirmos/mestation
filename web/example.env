# Copy to .env.local and fill in. Never commit the real file.

# Contract addresses (see contracts/deployments/)
NEXT_PUBLIC_USDC=
NEXT_PUBLIC_PAY=
NEXT_PUBLIC_MARKET=
# Optional. Defaults to the deployed ReputationRegistry.
NEXT_PUBLIC_REPUTATION=
# A block shortly before the contracts were deployed.
NEXT_PUBLIC_DEPLOY_BLOCK=

# Supabase (server only: keep the secret key out of the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Indexer
CRON_SECRET=
INDEX_START_TIME=2026-11-27T13:00:00Z

# Optional: put another ME node in front of the proxy.
ME_RPC_UPSTREAM=https://beta-hub-8545.explorer-testnet.me